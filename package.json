{
  "name": "novavideo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LibTV-equivalent AI video production workspace: infinite workflow canvas, storyboard projection, agent and generation pipeline.",
  "scripts": {
    "dev": "next dev --turbopack -p 3200",
    "build": "NEXT_DIST_DIR=.next-prod next build",
    "start": "NEXT_DIST_DIR=.next-prod next start -p 3200",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "e2e:prod": "PROD_URL=http://localhost:3300 playwright test production"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.6",
    "clsx": "^2.1.1",
    "immer": "^10.1.3",
    "nanoid": "^5.1.6",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.2.2"
}
